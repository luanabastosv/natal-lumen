# Base de dados PostgreSQL
DATABASE_URL=postgresql+psycopg://natal_lumen:SENHA@localhost:5432/natal_lumen

# Pasta dos arquivos enviados (cartoes, comprovantes).
# Precisa ficar FORA das pastas publicas do frontend.
ARQUIVOS_DIR=../arquivos

# Segredo do JWT da sessao. Gere um novo para producao com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-este-valor-em-producao

# desenvolvimento | homologacao | producao
#
#   desenvolvimento  seu computador. HTTP em localhost, CORS para o Vite,
#                    /docs aberta, link de definir senha volta na resposta.
#   homologacao      servidor de teste. HTTPS, sem CORS, /docs aberta (util
#                    para testar), SEM o atalho do link de senha.
#   producao         o que vale. HTTPS, sem CORS, sem /docs, sem atalho.
#
# Valor desconhecido faz o servidor RECUSAR a subir, de proposito: um
# "AMBIENTE=prod" escrito errado daria cookie sem HTTPS em silencio.
AMBIENTE=desenvolvimento

# Lidos pelo systemd, nao pela aplicacao.
# Producao 2, homologacao 1. Cada worker ocupa ~152 MB.
UVICORN_PORTA=8000
UVICORN_WORKERS=2

# Tamanho maximo de arquivo enviado, em MB (foto de cartao, planilha).
# MAX_UPLOAD_MB=15

# --- WhatsApp Cloud API (Meta) ---
# Vazio = desligado. Sem isto o sistema so oferece o download manual do cartao.
# Como obter: docs/AGRADECIMENTO.md, secao "Envio automatico".
# WHATSAPP_TOKEN=EAAG...
# WHATSAPP_PHONE_NUMBER_ID=123456789012345
# Nome do template APROVADO na Meta e o idioma dele.
# WHATSAPP_TEMPLATE=cartao_agradecimento
# WHATSAPP_IDIOMA=pt_BR
# WHATSAPP_VERSAO_API=v21.0

# --- Google Drive (comprovantes de pagamento) ---
# Vazio = desligado. O comprovante continua sendo gravado em disco; o Drive e
# so um espelho. Passo a passo: docs/COMPROVANTE_NO_DRIVE.md
# Caminho do JSON da conta de servico (chmod 600, dono = natal-lumen),
# ou o JSON inteiro colado numa linha so.
# DRIVE_CREDENCIAIS=/etc/natal-lumen/conta-de-servico.json
# Id da pasta DENTRO de um Drive Compartilhado. Pasta do "Meu Drive" NAO serve:
# la o arquivo fica sendo da conta de servico, que nao tem cota.
# DRIVE_PASTA_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz

# --- Mercado Pago (link de pagamento no cartao) ---
# Vazio = desligado: a opcao "Cartao (link)" nao aparece no apadrinhar.
# Passo a passo: docs/MERCADO_PAGO.md
# No seu computador use o Access Token da CONTA DE TESTE (vendedor de teste).
# MERCADOPAGO_ACCESS_TOKEN=APP_USR-...
# "Assinatura secreta" dos Webhooks, no painel do Mercado Pago (so no servidor).
# MERCADOPAGO_SEGREDO_WEBHOOK=
# Por quantos minutos o link vale e as criancas ficam reservadas.
# MERCADOPAGO_LINK_MINUTOS=30
# Teto de parcelas no cartao. 0 = o que estiver configurado na conta.
# MERCADOPAGO_PARCELAS_MAX=0
# Endereco publico do sistema, para o Mercado Pago avisar quando o padrinho
# paga. Deixe vazio no seu computador (o Mercado Pago nao alcanca localhost).
# URL_PUBLICA=https://acesso.natallumen.com
