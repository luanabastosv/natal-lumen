{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/backgrounds/**",
              "components/cards/**",
              "components/core/**",
              "components/feedback/**",
              "components/marketing/**",
              "components/media/**",
              "components/navigation/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Checkin|Typold|Typold Condensed|Typold Extended))/i]",
        "message": "Font not provided by the design system. Available: Checkin, Typold, Typold Condensed, Typold Extended."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|year|size|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: label, year, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrowserCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|children|imageSlot|dark|key|ref|className|style|children)$/]",
        "message": "<BrowserCard> doesn't accept that prop. Declared props: title, children, imageSlot, dark."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|disabled|iconLeft|children|onClick|as|href|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, disabled, iconLeft, children, onClick, as, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:button|a)$/]",
        "message": "<Button> as must be one of 'button' | 'a'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CampaignPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|rotate|key|ref|className|style|children)$/]",
        "message": "<CampaignPill> doesn't accept that prop. Declared props: children, tone, rotate."
      },
      {
        "selector": "JSXOpeningElement[name.name='CampaignPill'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:amber|navy|cream)$/]",
        "message": "<CampaignPill> tone must be one of 'amber' | 'navy' | 'cream'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CTASection'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|key|ref|className|style|children)$/]",
        "message": "<CTASection> doesn't accept that prop. Declared props: kind."
      },
      {
        "selector": "JSXOpeningElement[name.name='CTASection'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:donate|sponsor|volunteer)$/]",
        "message": "<CTASection> kind must be one of 'donate' | 'sponsor' | 'volunteer'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DecorativeBackground'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|children|key|ref|className|style|children)$/]",
        "message": "<DecorativeBackground> doesn't accept that prop. Declared props: variant, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='DecorativeBackground'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:sparkles|blob)$/]",
        "message": "<DecorativeBackground> variant must be one of 'sparkles' | 'blob'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DuotonePhoto'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|tone|radius|key|ref|className|style|children)$/]",
        "message": "<DuotonePhoto> doesn't accept that prop. Declared props: src, alt, tone, radius."
      },
      {
        "selector": "JSXOpeningElement[name.name='DuotonePhoto'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:navy|amber)$/]",
        "message": "<DuotonePhoto> tone must be one of 'navy' | 'amber'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DuotonePhoto'] > JSXAttribute[name.name='radius'] > Literal[value!=/^(?:none|md|lg)$/]",
        "message": "<DuotonePhoto> radius must be one of 'none' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:illustration|title|body|action|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: illustration, title, body, action."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute[name.name='illustration'] > Literal[value!=/^(?:mascot|children)$/]",
        "message": "<EmptyState> illustration must be one of 'mascot' | 'children'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:storeOpen|key|ref|className|style|children)$/]",
        "message": "<SiteHeader> doesn't accept that prop. Declared props: storeOpen."
      },
      {
        "selector": "JSXOpeningElement[name.name='StoreBanner'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|key|ref|className|style|children)$/]",
        "message": "<StoreBanner> doesn't accept that prop. Declared props: open."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
